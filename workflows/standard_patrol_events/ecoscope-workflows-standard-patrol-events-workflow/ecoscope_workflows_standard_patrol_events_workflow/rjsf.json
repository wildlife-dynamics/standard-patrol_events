    "area_scope": {
      "additionalProperties": false,
      "properties": {
        "level": {
          "description": "Reporting level.",
          "enum": [
            "site",
            "national",
            "region",
            "protected_area"
          ],
          "title": "Level",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Name of the area within the level's `report:<level>` feature group.",
          "title": "Unit"
        }
      },
      "required": [
        "level"
      ],
      "type": "object",
      "title": "Spatial Scope"
    },
    "patrol_params": {
      "additionalProperties": false,
      "properties": {
        "patrol_types": {
          "description": "Specify the patrol type(s) to analyze (optional). Leave empty to analyze all patrol types.",
          "items": {
            "type": "string"
          },
          "title": "Patrol Types",
          "type": "array"
        }
      },
      "required": [
        "patrol_types"
      ],
      "type": "object",
      "title": "Patrols"
    },
    "team_groups": {
      "additionalProperties": false,
      "properties": {
        "vars": {
          "items": {
            "type": "string"
          },
          "title": "Team subject groups",
          "type": "array",
          "description": "Subject groups that count as teams. Leave empty to use the patrol leader.",
          "default": []
        }
      },
      "required": [
        "vars"
      ],
      "type": "object",
      "title": "Team Subject Groups"
    },
    "effort_grouper": {
      "additionalProperties": false,
      "properties": {
        "var": {
          "title": "Group patrol effort by",
          "type": "string",
          "default": "patrol_type",
          "oneOf": [
            {
              "const": "patrol_type",
              "title": "Patrol type"
            },
            {
              "const": "team",
              "title": "Team"
            },
            {
              "const": "individual_patrol",
              "title": "Individual patrol"
            }
          ]
        }
      },
      "required": [
        "var"
      ],
      "type": "object",
      "title": "Patrol Effort"
    },
    "labels": {
      "additionalProperties": false,
      "properties": {
        "language": {
          "default": "en",
          "description": "Report language: 'en', 'es' or 'pt'.",
          "enum": [
            "en",
            "es",
            "pt"
          ],
          "title": "Language",
          "type": "string"
        }
      },
      "type": "object",
      "description": "Column and label strings for patrol & events reports in en, es or pt.",
      "required": [],
      "title": "Report Language"
    },
    "period_events": {
      "additionalProperties": false,
      "properties": {
        "event_types": {
          "description": "Specify the event type(s) to analyze (optional). Leave this section empty to analyze all event types.",
          "items": {
            "type": "string"
          },
          "title": "Event Types",
          "type": "array"
        }
      },
      "required": [
        "event_types"
      ],
      "type": "object",
      "title": "Event Types"
    },
    "retrieved_events": {
      "additionalProperties": false,
      "properties": {
        "retrieval": {
          "default": "all_in_period",
          "description": "Patrols plus all events in the period, or only the events linked to those patrols.",

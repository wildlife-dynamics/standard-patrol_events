            "all_in_period",
            "linked_only"
          ],
          "title": "Event retrieval",
          "type": "string"
        }
      },
      "required": [],
      "type": "object",
      "title": "Event Retrieval"
    },
    "state_events": {
      "additionalProperties": false,
      "properties": {
        "state": {
          "default": "all",
          "description": "All events, resolved only, or active (new + active) only. Only useful where the site uses event state for data QA.",
          "enum": [
            "all",
            "resolved",
            "active"
          ],
          "title": "Event state",
          "type": "string"
        }
      },
      "required": [],
      "type": "object",
      "title": "Event State"
    },
    "event_grouping": {
      "additionalProperties": false,
      "properties": {
        "var": {
          "title": "Group events by",
          "type": "string",
          "default": "event_type_display",
          "oneOf": [
            {
              "const": "event_type_display",
              "title": "Event type"
            },
            {
              "const": "event_category_display",
              "title": "Event category"
            }
          ]
        }
      },
      "required": [
        "var"
      ],
      "type": "object",
      "title": "Event Grouping"
    },
    "event_details": {
      "additionalProperties": false,
      "properties": {
        "detail_fields": {
          "anyOf": [
            {
              "additionalProperties": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Detail keys to show per event type (type value, display name or '*').",
          "title": "Detail Fields"
        },
        "max_fields": {
          "default": 6,
          "description": "Most details shown per event; the rest become '+N more'.",
          "title": "Max Fields",
          "type": "integer"
        }
      },
      "required": [],
      "type": "object",
      "title": ""
    },
    "detail_mode": {
      "additionalProperties": false,
      "properties": {
        "var": {
          "title": "Event detail mode",
          "type": "string",
          "default": "general",
          "oneOf": [
            {
              "const": "general",
              "title": "General table"
            },
            {
              "const": "per_type",
              "title": "One table per event type"
            }
          ]
        }
      },
      "required": [
        "var"
      ],
      "type": "object",
      "title": "Event Details"
    },
    "event_detail_tables": {
      "additionalProperties": false,
      "properties": {
        "detail_fields": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "description": "Detail keys to show per event type (type value or display name).",
          "title": "Detail Fields",
          "type": "object"
        }
      },
      "required": [
        "detail_fields"
      ],
      "type": "object",
      "title": "Event Fields Shown"

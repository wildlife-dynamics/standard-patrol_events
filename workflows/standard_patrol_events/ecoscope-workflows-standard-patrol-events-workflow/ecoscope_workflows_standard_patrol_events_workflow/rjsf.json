            "attachments",
            "blank"
          ],
          "title": "Images",
          "type": "string"
        },
        "max_images": {
          "default": 50,
          "minimum": 0,
          "title": "Maximum number of images",
          "type": "integer"
        }
      },
      "type": "object",
      "required": [],
      "title": "Images"
    },
    "report_blocks": {

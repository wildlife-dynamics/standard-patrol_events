          "title": ""
        }
      },
      "required": [
        "data_source"
      ],
      "type": "object",
      "title": "Data Source"
    },
    "time_range": {
      "additionalProperties": false,
      "properties": {
        "since": {
          "description": "The start time",
          "format": "date-time",
          "title": "Since",
          "type": "string"
        },
        "until": {
          "description": "The end time",
          "format": "date-time",
          "title": "Until",
          "type": "string"
        },
        "timezone": {
          "$ref": "#/$defs/TimezoneInfo",
          "default": null,
          "title": "Timezone"
        }
      },
      "required": [
        "since",
        "until"
      ],
      "type": "object",
      "description": "Choose the period of time to analyze.",
      "title": "Time Range"
    },
    "base_maps": {
      "additionalProperties": false,
      "properties": {
        "base_maps": {

{
  "properties": {
    "workflow_details": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Workflow Name",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Workflow Description",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object",
      "description": "Add information that will help to differentiate this workflow from another.",
      "title": "Workflow Details"
    },
    "er_client": {
      "additionalProperties": false,
      "properties": {
        "data_source": {
          "$ref": "#/$defs/EarthRangerConnection",
          "description": "Select one of your configured data sources.",
          "title": ""
        }
      },
      "required": [
        "data_source"
      ],
      "type": "object",
      "title": "Data Source"
    },
    "time_range": {
      "additionalProperties": false,
      "properties": {
        "since": {
          "description": "The start time",
          "format": "date-time",
          "title": "Since",
          "type": "string"
        },
        "until": {
          "description": "The end time",
          "format": "date-time",
          "title": "Until",
          "type": "string"
        },
        "timezone": {
          "$ref": "#/$defs/TimezoneInfo",
          "default": null,
          "title": "Timezone"
        }
      },
      "required": [
        "since",
        "until"
      ],
      "type": "object",
      "description": "Choose the period of time to analyze.",
      "title": "Time Range"
    },
    "base_maps": {
      "additionalProperties": false,
      "properties": {
        "base_maps": {
          "default": [
            {
              "url": "https://server.arcgisonline.com/ArcGIS/rest/services/World_Topo_Map/MapServer/tile/{z}/{y}/{x}",
              "opacity": 1,
              "max_zoom": 20,
              "min_zoom": 0
            },
            {
              "url": "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}",
              "opacity": 0.5,
              "max_zoom": 20,
              "min_zoom": 0
            }
          ],
          "description": "Select tile layers to use as base layers in map outputs. The first layer in the list will be the bottommost layer displayed.",
          "ecoscope:advanced": true,
          "items": {
            "anyOf": [
              {
                "description": "A tiled raster layer loaded on-demand from a URL template (e.g., base maps).",
                "properties": {
                  "url": {
                    "default": "https://tile.openstreetmap.org/{z}/{x}/{y}.png",
                    "title": "Preset Layer URL",
                    "type": "string",
                    "const": "https://tile.openstreetmap.org/{z}/{x}/{y}.png",
                    "enum": [
                      "https://tile.openstreetmap.org/{z}/{x}/{y}.png"
                    ]
                  },
                  "opacity": {
                    "default": 1,
                    "description": "Set layer transparency from 1 (fully visible) to 0 (hidden).",
                    "ecoscope:advanced": true,
                    "maximum": 1,
                    "minimum": 0,
                    "title": "Layer Opacity",
                    "type": "number"
                  }
                },
                "title": "Open Street Map",
                "type": "object"
              },
              {
                "description": "A tiled raster layer loaded on-demand from a URL template (e.g., base maps).",
                "properties": {
                  "url": {
                    "default": "https://server.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/tile/{z}/{y}/{x}",
                    "title": "Preset Layer URL",
                    "type": "string",
                    "const": "https://server.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/tile/{z}/{y}/{x}",
                    "enum": [
                      "https://server.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/tile/{z}/{y}/{x}"
                    ]
                  },
                  "opacity": {
                    "default": 1,
                    "description": "Set layer transparency from 1 (fully visible) to 0 (hidden).",
                    "ecoscope:advanced": true,
                    "maximum": 1,
                    "minimum": 0,
                    "title": "Layer Opacity",
                    "type": "number"
                  }
                },
                "title": "Roadmap",
                "type": "object"
              },
              {
                "description": "A tiled raster layer loaded on-demand from a URL template (e.g., base maps).",
                "properties": {
                  "url": {
                    "default": "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}",
                    "title": "Preset Layer URL",
                    "type": "string",
                    "const": "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}",
                    "enum": [
                      "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}"
                    ]
                  },
                  "opacity": {
                    "default": 1,
                    "description": "Set layer transparency from 1 (fully visible) to 0 (hidden).",
                    "ecoscope:advanced": true,
                    "maximum": 1,
                    "minimum": 0,
                    "title": "Layer Opacity",
                    "type": "number"
                  }
                },
                "title": "Satellite",
                "type": "object"
              },
              {
                "description": "A tiled raster layer loaded on-demand from a URL template (e.g., base maps).",
                "properties": {
                  "url": {
                    "default": "https://server.arcgisonline.com/ArcGIS/rest/services/World_Topo_Map/MapServer/tile/{z}/{y}/{x}",
                    "title": "Preset Layer URL",
                    "type": "string",
                    "const": "https://server.arcgisonline.com/ArcGIS/rest/services/World_Topo_Map/MapServer/tile/{z}/{y}/{x}",
                    "enum": [
                      "https://server.arcgisonline.com/ArcGIS/rest/services/World_Topo_Map/MapServer/tile/{z}/{y}/{x}"
                    ]
                  },
                  "opacity": {
                    "default": 1,
                    "description": "Set layer transparency from 1 (fully visible) to 0 (hidden).",
                    "ecoscope:advanced": true,
                    "maximum": 1,
                    "minimum": 0,
                    "title": "Layer Opacity",
                    "type": "number"
                  }
                },
                "title": "Terrain",
                "type": "object"
              },
              {
                "description": "A tiled raster layer loaded on-demand from a URL template (e.g., base maps).",
                "properties": {
                  "url": {
                    "default": "https://server.arcgisonline.com/arcgis/rest/services/Elevation/World_Hillshade/MapServer/tile/{z}/{y}/{x}",
                    "title": "Preset Layer URL",
                    "type": "string",
                    "const": "https://server.arcgisonline.com/arcgis/rest/services/Elevation/World_Hillshade/MapServer/tile/{z}/{y}/{x}",
                    "enum": [
                      "https://server.arcgisonline.com/arcgis/rest/services/Elevation/World_Hillshade/MapServer/tile/{z}/{y}/{x}"
                    ]
                  },
                  "opacity": {
                    "default": 1,
                    "description": "Set layer transparency from 1 (fully visible) to 0 (hidden).",
                    "ecoscope:advanced": true,
                    "maximum": 1,
                    "minimum": 0,
                    "title": "Layer Opacity",
                    "type": "number"
                  }
                },
                "title": "USGS Hillshade",
                "type": "object"
              },
              {
                "description": "A tiled raster layer loaded on-demand from a URL template (e.g., base maps).",
                "properties": {
                  "url": {
                    "default": "https://example.tiles.com/{z}/{x}/{y}.png",
                    "description": "The URL of a publicly accessible tiled raster service.",
                    "pattern": "https?:\\/\\/(www\\.)?[-a-zA-Z0-9@:%._\\+~#=]{1,256}\\.[a-zA-Z0-9()]{1,6}([-a-zA-Z0-9()@:%_\\+.~#?&//=\\{\\}]*)",
                    "title": "Custom Layer URL",
                    "type": "string"
                  },
                  "opacity": {
                    "default": 1,
                    "description": "Set layer transparency from 1 (fully visible) to 0 (hidden).",
                    "ecoscope:advanced": true,
                    "maximum": 1,
                    "minimum": 0,
                    "title": "Custom Layer Opacity",
                    "type": "number"
                  },
                  "max_zoom": {
                    "default": 20,
                    "description": "Set the maximum zoom level to fetch tiles for.",
                    "title": "Custom Layer Max Zoom",
                    "type": "integer"
                  },
                  "min_zoom": {
                    "default": 0,
                    "description": "Set the minimum zoom level to fetch tiles for.",
                    "title": "Custom Layer Min Zoom",
                    "type": "integer"
                  }
                },
                "title": "Custom Layer (Advanced)",
                "type": "object"
              }
            ],
            "title": "Base Layer"
          },
          "title": " ",
          "type": "array"
        }
      },
      "type": "object",
      "required": [],
      "title": "Base Maps"
    },
    "patrol_filter": {
      "additionalProperties": true,
      "properties": {},
      "type": "object",
      "required": [],
      "title": "Patrol Filter",
      "description": "Optional: limit the patrols to one team, team leader or patrol. Leave unticked to include all patrols.",
      "allOf": [
        {
          "if": {
            "anyOf": [
              {
                "properties": {
                  "team": {
                    "const": true
                  }
                },
                "required": [
                  "team"
                ]
              },
              {
                "properties": {
                  "team_leader": {
                    "const": true
                  }
                },
                "required": [
                  "team_leader"
                ]
              }
            ]
          },
          "else": {
            "properties": {
              "single_patrol": {
                "title": "Single Patrol",
                "type": "boolean",
                "default": false
              }
            }
          }
        },
        {
          "if": {
            "anyOf": [
              {
                "properties": {
                  "single_patrol": {
                    "const": true
                  }
                },
                "required": [
                  "single_patrol"
                ]
              },
              {
                "properties": {
                  "team_leader": {
                    "const": true
                  }
                },
                "required": [
                  "team_leader"
                ]
              }
            ]
          },
          "else": {
            "properties": {
              "team": {
                "title": "Team",
                "type": "boolean",
                "default": false
              }
            }
          }
        },
        {
          "if": {
            "anyOf": [
              {
                "properties": {
                  "single_patrol": {
                    "const": true
                  }
                },
                "required": [
                  "single_patrol"
                ]
              },
              {
                "properties": {
                  "team": {
                    "const": true
                  }
                },
                "required": [
                  "team"
                ]
              }
            ]
          },
          "else": {
            "properties": {
              "team_leader": {
                "title": "Team Leader",
                "type": "boolean",
                "default": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "single_patrol": {
                "const": true
              }
            },
            "required": [
              "single_patrol"
            ]
          },
          "then": {
            "properties": {
              "patrol_id": {
                "title": "Patrol ID",
                "type": "string",
                "description": "The patrol to analyze, matched against its serial number (the ID shown in EarthRanger)."
              }
            },
            "required": [
              "patrol_id"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "team": {
                "const": true
              }
            },
            "required": [
              "team"
            ]
          },
          "then": {
            "properties": {
              "teams": {
                "title": " ",
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                },
                "description": "Team names as set in EarthRanger's patrol configuration."
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "team_leader": {
                "const": true
              }
            },
            "required": [
              "team_leader"
            ]
          },
          "then": {
            "properties": {
              "leaders": {
                "title": " ",
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                },
                "description": "Leader names as in EarthRanger."
              }
            }
          }
        }
      ]
    },
    "patrol_grouping": {
      "additionalProperties": false,
      "properties": {
        "var": {
          "title": " ",
          "type": "string",
          "default": "patrol_type",
          "oneOf": [
            {
              "const": "patrol_type",
              "title": "Patrol Type"
            },
            {
              "const": "patrol_team_name",
              "title": "Team"
            }
          ]
        }
      },
      "required": [
        "var"
      ],
      "type": "object",
      "title": "Patrol Grouping",
      "description": "Choose how patrol tracks are coloured on the map. Tracks without a team use their leader's name."
    },
    "state_events": {
      "additionalProperties": false,
      "properties": {
        "states": {
          "title": " ",
          "type": "array",
          "uniqueItems": true,
          "default": [],
          "items": {
            "type": "string",
            "oneOf": [
              {
                "const": "new",
                "title": "New"
              },
              {
                "const": "active",
                "title": "Active"
              },
              {
                "const": "resolved",
                "title": "Resolved"
              },
              {
                "const": "review",
                "title": "Review"
              }
            ]
          }
        }
      },
      "required": [],
      "type": "object",
      "title": "Event State",
      "description": "Choose to analyze events with a certain state. If left empty, events of all states will be analyzed"
    },
    "event_grouping": {
      "additionalProperties": false,
      "properties": {
        "var": {
          "title": " ",
          "type": "string",
          "default": "event_type_display",
          "oneOf": [
            {
              "const": "event_type_display",
              "title": "Event Type"
            },
            {
              "const": "event_category_display",
              "title": "Event Category"
            }
          ]
        }
      },
      "required": [
        "var"
      ],
      "type": "object",
      "title": "Event Grouping",
      "description": "Choose how events are grouped in the tables, charts and map colours."
    },
    "event_details_settings": {
      "additionalProperties": true,
      "properties": {
        "all_details": {
          "title": "Show all fields",
          "type": "boolean",
          "default": true,
          "description": "When ticked, every event is shown with all its details. Untick to choose the fields for each event type."
        }
      },
      "type": "object",
      "required": [],
      "title": "Event Details",
      "if": {
        "properties": {
          "all_details": {
            "const": false
          }
        },
        "required": [
          "all_details"
        ]
      },
      "then": {
        "properties": {
          "tables": {
            "title": " ",
            "type": "array",
            "default": [],
            "description": "Add an event type and choose the fields to show for it. Event types you don't add show their first 3 fields.",
            "items": {
              "type": "object",
              "title": " ",
              "additionalProperties": false,
              "properties": {
                "event_type": {
                  "title": "Event Type",
                  "type": "string",
                  "ecoscope:transform": [
                    {
                      "transformer": "EarthRangerEnumResolver",
                      "transformer_kws": {
                        "type": "event_type",
                        "depends_on": "properties.er_client.properties.data_source.properties.name"
                      }
                    }
                  ]
                },
                "fields": {
                  "title": "Fields",
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Field names as on the event form, one per line."
                }
              },
              "required": [
                "event_type"
              ]
            }
          }
        }
      }
    },
    "download_attachments": {
      "additionalProperties": false,
      "properties": {
        "skip_download": {
          "default": false,
          "description": "Event photos are included in the report. Tick to leave them out.",
          "title": "Leave Out Event Photos",
          "type": "boolean"
        },
        "max_images": {
          "default": 50,
          "description": "Used when photos are included.",
          "ecoscope:advanced": true,
          "minimum": 0,
          "title": "Maximum Images",
          "type": "integer"
        }
      },
      "type": "object",
      "required": [],
      "title": "Download Event Attachments"
    },
    "report_text": {
      "additionalProperties": false,
      "properties": {
        "language": {
          "title": "Language",
          "description": "Choose the language for the report's headings and labels.",
          "type": "string",
          "default": "en",
          "oneOf": [
            {
              "const": "en",
              "title": "English"
            },
            {
              "const": "es",
              "title": "Espa\u00f1ol"
            },
            {
              "const": "pt",
              "title": "Portugu\u00eas"
            }
          ]
        },
        "title": {
          "default": "Patrol & Events Report",
          "description": "Enter the main heading for the first page.",
          "title": "Title",
          "type": "string"
        },
        "subtitle": {
          "default": "",
          "description": "Add an optional line under the title, e.g. the protected area.",
          "title": "Subtitle",
          "type": "string"
        },
        "details_intro": {
          "default": "",
          "description": "Add optional text to show before the event details.",
          "ecoscope:advanced": true,
          "title": "Event Details Introduction",
          "type": "string"
        },
        "sections": {
          "default": [
            "headline_stats",
            "personnel",
            "time_density",
            "event_density",
            "events_chart",
            "monthly_chart",
            "category_priority",
            "conclusions"
          ],
          "description": "Remove any sections you don't need. All are included by default.",
          "items": {
            "type": "string",
            "oneOf": [
              {
                "const": "headline_stats",
                "title": "Headline Figures"
              },
              {
                "const": "personnel",
                "title": "Personnel"
              },
              {
                "const": "time_density",
                "title": "Patrol Time Density Map"
              },
              {
                "const": "event_density",
                "title": "Event Density Map"
              },
              {
                "const": "events_chart",
                "title": "Events Chart"
              },
              {
                "const": "monthly_chart",
                "title": "Events by Month"
              },
              {
                "const": "category_priority",
                "title": "Events by Category and Priority"
              },
              {
                "const": "conclusions",
                "title": "Conclusions Box"
              }
            ]
          },
          "title": "Report Sections",
          "type": "array",
          "uniqueItems": true
        }
      },
      "type": "object",
      "required": [],
      "title": "Report Settings",
      "description": "Name the report, choose its language and pick what it includes."
    },
    "Data Export": {
      "type": "object",
      "description": "",
      "ecoscope:task_group": true,
      "properties": {
        "export_patrol_tracks": {
          "additionalProperties": false,
          "properties": {
            "filetypes": {
              "default": [
                "geoparquet"
              ],
              "description": "File formats for the patrol tracks shown on the map. Pick one or more; GeoParquet and GeoPackage open in QGIS/ArcGIS.",
              "items": {
                "enum": [
                  "csv",
                  "gpkg",
                  "geoparquet",
                  "parquet"
                ],
                "type": "string"
              },
              "title": "Patrol Tracks File Formats",
              "type": "array",
              "uniqueItems": true
            }
          },
          "required": [],
          "type": "object",
          "title": ""
        },
        "export_patrol_events": {
          "additionalProperties": false,
          "properties": {
            "filetypes": {
              "default": [
                "geoparquet"
              ],
              "description": "File formats for the events shown on the map. Pick one or more; GeoParquet and GeoPackage open in QGIS/ArcGIS.",
              "items": {
                "enum": [
                  "csv",
                  "gpkg",
                  "geoparquet",
                  "parquet"
                ],
                "type": "string"
              },
              "title": "Event File Formats",
              "type": "array",
              "uniqueItems": true
            }
          },
          "required": [],
          "type": "object",
          "title": ""
        }
      }
    },
    "incident_storyboards": {
      "additionalProperties": false,
      "properties": {
        "var": {
          "title": "Show Incident Storyboards",
          "type": "boolean",
          "description": "Add the incident storyboards to the dashboard: each incident (a collection of related events) dated in the period, with its events in time order.",
          "default": false
        }
      },
      "required": [
        "var"
      ],
      "type": "object",
      "title": "Incident Storyboards"
    }
  },
  "$defs": {
    "EarthRangerConnection": {
      "properties": {
        "name": {
          "title": "Data Source",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "EarthRangerConnection",
      "type": "object"
    },
    "TimezoneInfo": {
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "tzCode": {
          "title": "Tzcode",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "utc": {
          "title": "Utc",
          "type": "string"
        }
      },
      "required": [
        "label",
        "tzCode",
        "name",
        "utc"
      ],
      "title": "TimezoneInfo",
      "type": "object"
    },
    "EventTypeFields": {
      "properties": {
        "event_type": {
          "title": "Event Type",
          "type": "string"
        },
        "fields": {
          "default": [],
          "description": "Field names as on the event form, one per line.",
          "items": {
            "type": "string"
          },
          "title": "Fields",
          "type": "array"
        }
      },
      "required": [
        "event_type"
      ],
      "title": "EventTypeFields",
      "type": "object"
    }
  },
  "uiSchema": {
    "workflow_details": {
      "ui:order": [
        "name",
        "description"
      ]
    },
    "time_range": {
      "ui:order": [
        "since",
        "until",
        "timezone"
      ]
    },
    "patrol_filter": {
      "ui:order": [
        "team",
        "teams",
        "team_leader",
        "leaders",
        "single_patrol",
        "patrol_id"
      ],
      "ui:options": {
        "expandable": false
      },
      "additionalProperties": {
        "ui:widget": "hidden"
      }
    },
    "patrol_effort": {
      "ui:order": [
        "group_by",
        "map_layer",
        "columns",
        "ranger_effort"
      ],
      "ui:options": {
        "expandable": false
      },
      "additionalProperties": {
        "ui:widget": "hidden"
      }
    },
    "event_details_settings": {
      "ui:order": [
        "all_details",
        "tables"
      ],
      "tables": {
        "items": {
          "ui:options": {
            "label": false
          }
        }
      },
      "ui:options": {
        "expandable": false
      },
      "additionalProperties": {
        "ui:widget": "hidden"
      }
    },
    "download_attachments": {
      "ui:order": [
        "skip_download",
        "max_images"
      ]
    },
    "report_text": {
      "ui:order": [
        "title",
        "subtitle",
        "language",
        "sections",
        "details_intro"
      ],
      "title": {
        "ui:placeholder": "Patrol & Events Report"
      },
      "subtitle": {
        "ui:placeholder": "e.g. Parque Nacional Los Alerces"
      },
      "details_intro": {
        "ui:widget": "textarea",
        "ui:placeholder": "e.g. Events recorded by rangers during the period."
      }
    },
    "Data Export": {
      "ui:order": [
        "export_patrol_tracks",

      ]
    },
    "ui:order": [
      "workflow_details",
      "er_client",
      "time_range",
      "base_maps",
      "patrol_filter",
      "patrol_type",
      "patrol_effort",
      "patrol_grouping",
      "event_scope",
      "event_type",
